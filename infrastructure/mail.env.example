# Copy to gitignored .env.mail; use chmod 600. Never commit filled credentials.
# Exact SMTP destinations only. Remote servers require TLS.
MAIL_SMTP_ALLOWLIST=mailpit:1025
MAILPIT_HOST=mailpit
# Copy the real journal UUID shown in the UI server setup guide.
MAIL_CREDENTIAL_EDITORIAL_JOURNAL_ID=
MAIL_CREDENTIAL_EDITORIAL_PASSWORD=
MAIL_CREDENTIAL_GMAIL_JOURNAL_ID=
MAIL_CREDENTIAL_GMAIL_ACCESS_TOKEN=
MAIL_CREDENTIAL_OUTLOOK_JOURNAL_ID=
MAIL_CREDENTIAL_OUTLOOK_ACCESS_TOKEN=
